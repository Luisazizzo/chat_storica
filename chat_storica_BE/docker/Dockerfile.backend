# Dockerfile per backend FastAPI

FROM python:3.12-slim

WORKDIR /app

# Dipendenze di sistema per Docling (PDF parsing)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copia requirements e installa dipendenze Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia il codice dell'applicazione
COPY . .

# Crea le directory necessarie
RUN mkdir -p logs data/corpus

# Esponi porta FastAPI
EXPOSE 8000

# Avvia FastAPI con Uvicorn
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
